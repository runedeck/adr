{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://runedeck.dev/schema/runeadr.frontmatter.json",
    "title": "runeADR frontmatter",
    "description": "Frontmatter contract for runeADR decision records. Values stay flat: strings and lists of strings.",
    "type": "object",
    "required": [
        "title",
        "description",
        "type",
        "category",
        "tags",
        "status",
        "created",
        "updated",
        "author",
        "project",
        "upstream",
        "responsible",
        "accountable"
    ],
    "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "const": "adr" },
        "category": { "enum": ["architecture", "process", "security"] },
        "tags": { "$ref": "#/$defs/stringList" },
        "status": { "enum": ["proposed", "accepted", "deprecated", "superseded"] },
        "created": { "type": "string", "format": "date" },
        "updated": { "type": "string", "format": "date" },
        "author": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "related": { "$ref": "#/$defs/stringList" },
        "upstream": { "$ref": "#/$defs/stringList" },
        "responsible": { "$ref": "#/$defs/stringList" },
        "accountable": { "$ref": "#/$defs/stringList" },
        "consulted": { "$ref": "#/$defs/stringList" },
        "informed": { "$ref": "#/$defs/stringList" }
    },
    "patternProperties": {
        "^x-rune-": {}
    },
    "additionalProperties": false,
    "$defs": {
        "stringList": {
            "type": "array",
            "items": { "type": "string" }
        }
    }
}
